[
  "qemu-system-x86_64",
  "-machine",
  "pc,hpet=on",
  "-cpu",
  "max",
  "-accel",
  "tcg,thread=single",
  "-smp",
  "1",
  "-m",
  "2G",
  "-bios",
  "/usr/share/ovmf/OVMF.fd",
  "-display",
  "none",
  "-serial",
  "file:/tmp/bursztyn-graphics-candidate-1920x1080/serial.log",
  "-qmp",
  "unix:/tmp/bursztyn-graphics-candidate-1920x1080/qmp.sock,server=on,wait=off",
  "-no-reboot",
  "-boot",
  "d",
  "-audiodev",
  "none,id=snd",
  "-device",
  "intel-hda",
  "-device",
  "hda-output,audiodev=snd",
  "-drive",
  "file=/tmp/bursztyn-graphics-candidate-1920x1080/mode.iso,if=none,id=boot,format=raw,readonly=on",
  "-device",
  "virtio-blk-pci,drive=boot,disable-legacy=on,bootindex=1",
  "-netdev",
  "user,id=n1",
  "-device",
  "virtio-net-pci,netdev=n1,disable-legacy=on",
  "-object",
  "rng-random,id=rng0,filename=/dev/urandom",
  "-device",
  "virtio-rng-pci,rng=rng0,disable-legacy=on",
  "-vga",
